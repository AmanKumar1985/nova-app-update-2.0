# Copy this file to ".env" and fill in your real values. Never commit ".env" to git.

PORT=3000
# For a single-server deployment, keep this on a persistent disk/volume.
DATABASE_FILE=./nova.db
# Comma-separated allowed frontend origins. Leave empty when the frontend is
# served by this same server.
CORS_ORIGIN=

# YouTube Data API v3 Key (Create at Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here
