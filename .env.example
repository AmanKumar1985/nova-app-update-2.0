# Copy this file to ".env" and fill in your real values. Never commit ".env" to git.

PORT=3000
# For a single-server deployment, keep this on a persistent disk/volume.
DATABASE_FILE=./nova.db
# Comma-separated allowed frontend origins. Leave empty when the frontend is
# served by this same server.
CORS_ORIGIN=

# --- OTP email delivery (recommended for Railway) ---
# Verify a sender domain in Resend, then create an API key at resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Nova <otp@yourdomain.com>

# Optional Gmail fallback. Use a Gmail "App Password", not your normal password.
GMAIL_USER=
# YouTube Data API v3 Key (Create at Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here
