# Copy this file to ".env" and fill in your real values. Never commit ".env" to git.

PORT=3000

# For a single-server deployment, keep this on a persistent disk/volume.
DATABASE_FILE=./nova.db

# Comma-separated allowed frontend origins. Leave empty when the frontend is
# served by this same server.
CORS_ORIGIN=

# YouTube Data API v3 Key (Create at Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google OAuth (for "Continue with Google" login)
# 1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web Application type)
# 3. Add Authorised redirect URI: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# WebRTC TURN server (for video/audio calls behind strict NAT/firewalls)
# Free option: https://dashboard.metered.ca/ — create a free account and get credentials
# Or use: https://www.twilio.com/stun-turn
TURN_URL=turn:your_turn_server:3478
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential
